<%- include('partials/header') %>

<div class="post-detail">
  <article class="glass post-card detail" style="--i: 0">
    <div class="post-head">
      <a href="/u/<%= post.username %>" class="post-author">
        <span class="avatar avatar-sm" aria-hidden="true"><%= post.username.charAt(0).toUpperCase() %></span>
        <span class="username"><%= post.username %></span>
      </a>
      <time class="time" datetime="<%= post.created_at.replace(' ', 'T') %>Z"><%= post.created_at %></time>
    </div>

    <div class="post-media">
      <img src="<%= post.image_url %>" alt="<%= post.caption || 'Photo' %>" />
    </div>

    <div class="post-actions">
      <button
        class="like-btn <%= post.liked_by_me ? 'liked' : '' %>"
        data-post="<%= post.id %>"
        aria-pressed="<%= post.liked_by_me ? 'true' : 'false' %>"
        <%= currentUser ? '' : 'disabled' %>
      >
        <span class="heart" aria-hidden="true"><%= post.liked_by_me ? '♥' : '♡' %></span>
        <span class="like-count"><%= post.like_count %></span>
        <span class="sr-only">likes</span>
      </button>
      <span class="action-btn">💬 <span><%= post.comment_count %></span><span class="sr-only">comments</span></span>

      <button
        type="button"
        class="action-btn share-btn"
        data-share-url="/posts/<%= post.id %>"
        aria-label="Share post"
      >
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <circle cx="18" cy="5" r="3"></circle>
          <circle cx="6" cy="12" r="3"></circle>
          <circle cx="18" cy="19" r="3"></circle>
          <path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"></path>
        </svg>
        <span class="share-label">Share</span>
      </button>

      <% if (currentUser && currentUser.id === post.user_id) { %>
        <form method="POST" action="/posts/<%= post.id %>/delete" class="inline-form danger-form"
              onsubmit="return confirm('Delete this post? This cannot be undone.');">
          <input type="hidden" name="_csrf" value="<%= csrf %>" />
          <button type="submit" class="action-btn danger">🗑 Delete</button>
        </form>
      <% } %>
    </div>

    <% if (post.caption) { %>
      <div class="post-caption">
        <a href="/u/<%= post.username %>" class="username"><%= post.username %></a>
        <span><%= post.caption %></span>
      </div>
    <% } %>

    <div class="comments">
      <h3 class="comments-title">Comments</h3>

      <% if (comments.length === 0) { %>
        <p class="muted small">No comments yet. Be the first!</p>
      <% } else { %>
        <ul class="comment-list">
          <% comments.forEach(function(c) { %>
            <li class="comment">
              <a href="/u/<%= c.username %>" class="avatar avatar-xs" aria-hidden="true"><%= c.username.charAt(0).toUpperCase() %></a>
              <div class="comment-body">
                <a href="/u/<%= c.username %>" class="username"><%= c.username %></a>
                <span><%= c.body %></span>
                <div class="comment-meta"><time datetime="<%= c.created_at.replace(' ', 'T') %>Z"><%= c.created_at %></time></div>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>

      <% if (currentUser) { %>
        <form method="POST" action="/posts/<%= post.id %>/comments" class="comment-form">
          <input type="hidden" name="_csrf" value="<%= csrf %>" />
          <span class="avatar avatar-xs" aria-hidden="true"><%= currentUser.username.charAt(0).toUpperCase() %></span>
          <input type="text" name="body" maxlength="1000" required placeholder="Add a comment…" aria-label="Add a comment" />
          <button type="submit" class="btn btn-primary btn-sm">Post</button>
        </form>
      <% } else { %>
        <p class="muted small"><a href="/login">Log in</a> to comment.</p>
      <% } %>
    </div>
  </article>

  <% /* Sponsored card below the comments on the detail page */ %>
  <%- include('partials/ad', { ad: ad, adIndex: 1 }) %>
</div>

<%- include('partials/footer') %>
