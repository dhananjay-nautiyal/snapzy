<%- include('partials/header') %>

<div class="profile">
  <div class="glass profile-head" style="--i: 0">
    <span class="avatar avatar-lg" aria-hidden="true"><%= user.username.charAt(0).toUpperCase() %></span>
    <div class="profile-info">
      <div class="profile-name-row">
        <h1 class="profile-username"><%= user.username %></h1>
        <% if (isOwn) { %>
          <a href="/posts/new" class="btn btn-primary btn-sm">＋ New post</a>
        <% } %>
      </div>
      <% if (user.bio) { %><p class="profile-bio"><%= user.bio %></p><% } %>
      <div class="profile-stats">
        <span><strong><%= stats.posts %></strong> posts</span>
        <span><strong><%= stats.likes_received %></strong> likes received</span>
        <span><strong><%= stats.comments_received %></strong> comments received</span>
      </div>
      <div class="muted small">Joined <%= user.created_at %></div>
    </div>
  </div>

  <% if (posts.length === 0) { %>
    <div class="empty-state">
      <div class="empty-icon" aria-hidden="true">🖼️</div>
      <h2>No posts yet</h2>
      <p class="muted">
        <% if (isOwn) { %>Share your first photo!<% } else { %>This user hasn't posted anything yet.<% } %>
      </p>
      <% if (isOwn) { %>
        <a href="/posts/new" class="btn btn-primary">Share a photo</a>
      <% } %>
    </div>
  <% } else { %>
    <div class="grid">
      <% posts.forEach(function(post, i) { %>
        <a href="/posts/<%= post.id %>" class="grid-item" style="--i: <%= Math.min(i, 8) %>">
          <img src="<%= post.image_url %>" alt="<%= post.caption || 'Photo' %>" loading="lazy" />
          <span class="grid-overlay">
            <span>♥ <%= post.like_count %></span>
            <span>💬 <%= post.comment_count %></span>
          </span>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
