<% /* Shared "Sponsored" glass card. Expects: ad { id, headline, sponsor,
       image_url, link_url }. Rendered only when an ad is present, so the
       UI stays clean until one is added via /admin. */ %>
<% if (ad) { %>
  <article class="glass post-card ad-card" style="--i: <%= typeof adIndex !== 'undefined' ? Math.min(adIndex, 8) : 3 %>">
    <div class="post-head">
      <span class="ad-badge">Sponsored</span>
      <% if (ad.sponsor) { %>
        <span class="ad-sponsor"><%= ad.sponsor %></span>
      <% } %>
    </div>

    <div class="post-media">
      <% if (ad.link_url) { %>
        <a href="/ad/<%= ad.id %>/click" rel="sponsored nofollow noopener" target="_blank">
          <img src="<%= ad.image_url %>" alt="<%= ad.headline %>" loading="lazy" />
        </a>
      <% } else { %>
        <img src="<%= ad.image_url %>" alt="<%= ad.headline %>" loading="lazy" />
      <% } %>
    </div>

    <div class="post-caption">
      <% if (ad.link_url) { %>
        <a class="ad-headline" href="/ad/<%= ad.id %>/click" rel="sponsored nofollow noopener" target="_blank"><%= ad.headline %></a>
      <% } else { %>
        <span class="ad-headline"><%= ad.headline %></span>
      <% } %>
      <% if (ad.link_url) { %>
        <span class="ad-cta">Learn more →</span>
      <% } %>
    </div>
  </article>
<% } %>
