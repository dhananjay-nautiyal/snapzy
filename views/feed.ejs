<%- include('partials/header') %>

<% if (posts.length === 0) { %>
  <div class="empty-state">
    <div class="empty-icon">📸</div>
    <h2>No photos yet</h2>
    <p class="muted">
      <% if (currentUser) { %>
        Share your first photo to get started.
      <% } else { %>
        Log in to share your first photo.
      <% } %>
    </p>
    <% if (currentUser) { %>
      <a href="/posts/new" class="btn btn-primary">Share a photo</a>
    <% } else { %>
      <div class="btn-row">
        <a href="/signup" class="btn btn-primary">Create account</a>
        <a href="/login" class="btn btn-ghost">Log in</a>
      </div>
    <% } %>
  </div>
<% } else { %>
  <div class="feed">
    <% posts.forEach(function(post) { %>
      <article class="card post-card">
        <div class="post-head">
          <a href="/u/<%= post.username %>" class="post-author">
            <span class="avatar avatar-sm"><%= post.username.charAt(0).toUpperCase() %></span>
            <span class="username"><%= post.username %></span>
          </a>
          <span class="muted time"><%= post.created_at %></span>
        </div>

        <a href="/posts/<%= post.id %>" class="post-image-link">
          <img src="<%= post.image_url %>" alt="<%= post.caption || 'Photo' %>" class="post-image" loading="lazy" />
        </a>

        <div class="post-actions">
          <button
            class="like-btn <%= post.liked_by_me ? 'liked' : '' %>"
            data-post="<%= post.id %>"
            aria-pressed="<%= post.liked_by_me ? 'true' : 'false' %>"
            <%= currentUser ? '' : 'disabled' %>
          >
            <span class="heart"><%= post.liked_by_me ? '♥' : '♡' %></span>
            <span class="like-count"><%= post.like_count %></span>
          </button>
          <a href="/posts/<%= post.id %>" class="action-btn">
            💬 <span><%= post.comment_count %></span>
          </a>
        </div>

        <% if (post.caption) { %>
          <div class="post-caption">
            <a href="/u/<%= post.username %>" class="username"><%= post.username %></a>
            <span><%= post.caption %></span>
          </div>
        <% } %>
      </article>
    <% }) %>
  </div>
<% } %>

<%- include('partials/footer') %>
