<%- include('partials/header') %>

<% if (posts.length === 0) { %>
  <div class="empty-state">
    <div class="empty-icon" aria-hidden="true">📸</div>
    <h2>No photos yet</h2>
    <p class="muted">
      <% if (currentUser) { %>
        Share your first photo to get started.
      <% } else { %>
        Log in to share your first photo.
      <% } %>
    </p>
    <% if (currentUser) { %>
      <a href="/posts/new" class="btn btn-primary">Share a photo</a>
    <% } else { %>
      <div class="btn-row">
        <a href="/signup" class="btn btn-primary">Create account</a>
        <a href="/login" class="btn btn-ghost">Log in</a>
      </div>
    <% } %>
  </div>
<% } else { %>
  <div class="feed">
    <% posts.forEach(function(post, i) { %>
      <article class="glass post-card" style="--i: <%= Math.min(i, 8) %>">
        <div class="post-head">
          <a href="/u/<%= post.username %>" class="post-author">
            <span class="avatar avatar-sm" aria-hidden="true"><%= post.username.charAt(0).toUpperCase() %></span>
            <span class="username"><%= post.username %></span>
          </a>
          <time class="time" datetime="<%= post.created_at.replace(' ', 'T') %>Z"><%= post.created_at %></time>
        </div>

        <div class="post-media">
          <a href="/posts/<%= post.id %>">
            <img src="<%= post.image_url %>" alt="<%= post.caption || 'Photo' %>" loading="lazy" />
          </a>
        </div>

        <div class="post-actions">
          <button
            class="like-btn <%= post.liked_by_me ? 'liked' : '' %>"
            data-post="<%= post.id %>"
            aria-pressed="<%= post.liked_by_me ? 'true' : 'false' %>"
            <%= currentUser ? '' : 'disabled' %>
          >
            <span class="heart" aria-hidden="true"><%= post.liked_by_me ? '♥' : '♡' %></span>
            <span class="like-count"><%= post.like_count %></span>
            <span class="sr-only">likes</span>
          </button>
          <a href="/posts/<%= post.id %>" class="action-btn">
            💬 <span><%= post.comment_count %></span>
            <span class="sr-only">comments</span>
          </a>
        </div>

        <% if (post.caption) { %>
          <div class="post-caption">
            <a href="/u/<%= post.username %>" class="username"><%= post.username %></a>
            <span><%= post.caption %></span>
          </div>
        <% } %>
      </article>

      <% /* Sponsored card slides in after the 3rd post (if an ad exists) */ %>
      <% if (ad && i === 2) { %>
        <%- include('partials/ad', { ad: ad, adIndex: 3 }) %>
      <% } %>
    <% }) %>

    <% /* If there are fewer than 3 posts, show the ad after the last one */ %>
    <% if (ad && posts.length > 0 && posts.length < 3) { %>
      <%- include('partials/ad', { ad: ad, adIndex: posts.length }) %>
    <% } %>
  </div>
<% } %>

<%- include('partials/footer') %>
